# Cloudflare Workers/Pages static-asset headers (this file is copied as-is
# into the static export output). app.ksiegai.pl fetches this manifest
# cross-origin (useAndroidVersionStatus.ts) to check for Android app
# updates — without this header the browser blocks the response with a CORS
# error, even though the request itself succeeds server-side.
/android/version.json
  Access-Control-Allow-Origin: https://app.ksiegai.pl
  Access-Control-Allow-Methods: GET

# Public KSH reference data (static JSON contract, no credentials) consumed by
# app.ksiegai.pl (incl. the Capacitor Android shell) and ksiegai-mcp.
/poradnik/ksh/data/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET
  Cache-Control: public, max-age=3600
